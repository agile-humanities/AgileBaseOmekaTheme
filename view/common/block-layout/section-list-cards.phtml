<!-- BEGIN TEMPLATE common/block-layout/section-list-cards -->
<div id="block-<?= $this->blockId; ?>" class="section-list section-list-cards region <?= $this->regionClass; ?> <?= $this->classes ?>" data-target-region-id="<?= $this->targetID; ?>">
    <?php if ($this->hasTitle): ?>
        <h2><?= $this->title; ?></h2>
    <?php endif; ?>
    <?php if ($this->hasIntroduction): ?>
        <div class='block-introduction'>
            <?= $this->introduction; ?>
        </div>
    <?php endif; ?>
    <?php if ($this->hasPages): ?>
    <div class="card-container">
        <ul class="cards grid">
            <?php // Each page as a card (the card display mode reads the page's Page summary block, or the older blocks). ?>
            <?php foreach($this->pages as $page): ?>
                <?= $this->card($page, ['containerElement' => 'li', 'classes' => 'item', 'label' => $this->cardLabel ?: null]) ?>
            <?php endforeach ?>
        </ul>
    </div>
    <?php endif; ?>
</div>
<!-- END TEMPLATE common/block-layout/section-list-cards -->
