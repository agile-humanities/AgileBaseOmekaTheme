<?php
/**
 * Item with metadata (Omeka core block), theme override: the item's media as an image list on the dark surface,
 * then an info panel (title, caption, description, link) with the full metadata behind a <details> disclosure.
 * Ported from the Southern Foodways build (commit c14be413).
 */
$translate = $this->plugin('translate');
$escape = $this->plugin('escapeHtml');
$headingTerm = $this->siteSetting('browse_heading_property_term');
?>
<div class="item-with-metadata">
  <?php foreach ($attachments as $attachment): ?>
    <?php $item = $attachment->item(); if (empty($item)) continue; ?>
    <div class="item resource">
      <div class="resource show">
        <?php if ($item->media()): ?>
          <div class="media-list image-container">
            <?php foreach ($item->media() as $media): ?>
              <figure><?= $media->linkRaw($this->thumbnail($media, 'large', ['title' => $media->displayTitle()]), null, ['class' => 'media resource']) ?></figure>
            <?php endforeach; ?>
          </div>
        <?php endif; ?>
        <div class="info-container">
          <div class="description-panel item-info reversed">
            <h3><?= $item->link($item->displayTitle()) ?></h3>
            <?php if ($caption = $attachment->caption()): ?>
              <div class="caption"><?= $caption ?></div>
            <?php endif; ?>
            <?php $values = $item->value('dcterms:description', ['all' => true]); ?>
            <?php if ($values): ?>
              <div class="description-text"><?php foreach ($values as $value) { echo $value->asHtml(); } ?></div>
            <?php endif; ?>
            <div class="item-link">
              <?= $item->link($headingTerm && $item->value($headingTerm) ? $item->value($headingTerm)->asHtml() : $translate('Find out more')) ?>
            </div>
            <details>
              <summary><?= $translate('Metadata') ?></summary>
              <div class="item-metadata-block">
                <div class="metadata-list">
                  <?= $item->displayValues() ?>
                  <?php $itemSets = $item->itemSets(); if (count($itemSets) > 0): ?>
                  <div class="property">
                    <div class="metadata-label"><?= $translate('Collections') ?></div>
                    <?php foreach ($itemSets as $itemSet): ?>
                      <div class="value"><a class="item-set-link" href="<?= $escape($itemSet->url()) ?>"><?= $escape($itemSet->displayTitle()) ?></a></div>
                    <?php endforeach; ?>
                  </div>
                  <?php endif; ?>
                </div>
              </div>
            </details>
          </div>
        </div>
      </div>
    </div>
  <?php endforeach; ?>
</div>
