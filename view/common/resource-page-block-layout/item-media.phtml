<?php

/** @var \Omeka\Api\Representation\AbstractResourceEntityRepresentation $resource */
$resourceMedia = $resource->media();
$partial = $this->plugin('sitePartial');
$assetUrl = $this->plugin('siteAssetUrl');
$options = ['hasVtt'=>$hasVtt];

/** @var \Omeka\Api\Representation\MediaRepresentation $primaryMedia */

?>
<!-- TEMPLATE BEGIN (theme) common/resource-page-block-layout/item-media.phtml -->
<?php if ($resourceMedia): ?>
  <div class="item-viewer media-embeds <?= $usePrimary ? 'primary-media' : '' ?> <?= !empty($primaryOnly) ? 'primary-only' : '' ?> <?= $hasVtt ? 'has-vtt' : '' ?>">

    <?php
      if ($useMirador):
        /** @var \Mirador\View\Helper\Mirador $mirador */
        $mirador = $this->plugin('mirador');
        echo $mirador($resource);

      elseif ($useUV):
        $uv = $this->plugin('universalViewer');
        echo $uv($resource);
      elseif ($usePrimary): ?>
        <?= $primaryMedia->render(); ?>
      <?php else: ?>
        <?php
          /** @var \Omeka\Api\Representation\MediaRepresentation $media */
          foreach ($displayMedia ?? $resourceMedia as $media): ?>
          <?php if ($hasVtt) {
            $options['label'] = sprintf("Transcript (%s)",$media->extension());
          }
          ?>
          <?php
            if ($audioPrimary && $media->mediaType() && strpos($media->mediaType(),'pdf') > -1):
              echo $partial('common/media/file-renderer/download',['label'=>'PDF','mediaUrl'=>$media->originalUrl(),'fileName'=>$media->filename()]);
            else:
              echo $media->render($options);
            endif;
          ?>
        <?php endforeach; ?>
      <?php endif; ?>
  </div>
  <?php // A text alternative for viewers that carry none of their own (IIIF, PDF, video). ?>
  <?php if (($useMirador || $useUV || ($usePrimary && $primaryMedia && !str_starts_with((string) $primaryMedia->mediaType(), 'text/'))) && $resource->value('dcterms:description')): ?>
  <div id="viewer-support" class="screen-reader-text">
    <div class="label"><?= $this->translate('Item description') ?></div>
    <div id="viewer-description"><?= $this->escapeHtml((string) $resource->value('dcterms:description')) ?></div>
  </div>
  <?php endif; ?>
<?php else: ?>
  <div class="item-viewer viewer-none">
    <?= $partial('common/resource-page-block-layout/item-media-placeholder') ?>
  </div>
<?php endif; ?>

<!-- TEMPLATE END common/resource-page-block-layout/item-media.phtml -->
