<!-- TEMPLATE BEGIN common/search-filters-links.phtml -->
<div class="search-filters">
    <?php foreach ($filters as $filterLabel => $filterValues): ?>
    <div class="filter">
        <?php
            $filterLabel =  $filterLabel == "Item Set" ? "Collection" : $filterLabel;
            $filterLabel =  str_replace('Unknown field contains','Results contain',$filterLabel);
            $filterLabel =  str_replace('Unknown field is exactly','Results are exactly',$filterLabel);
        ?>
        <span class="filter-label summary--text--label"><?= $escape($filterLabel) ?></span>
        <?php foreach ($filterValues as $urlQuery => $filterValue): ?>
        <a class='summary--text' href="<?= $escapeAttr($urlQuery) ?>" class="filter-value"><?= $escape($filterValue) ?>&nbsp;</a>
        <?php endforeach; ?>
    </div>
    <?php endforeach; ?>
</div>
