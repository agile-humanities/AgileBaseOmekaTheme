            <?php echo $this->partial('common/search-form'); ?>
        </div>
        <?php //echo $this->hyperlink($translate('Search by ID'), $this->url('site/resource', ['controller' => 'item', 'action' => 'search'], ['query' => $query], true), ['class' => 'search-by-id']); ?>
    </div>
    <?php endif; ?>
</div>

<?= $this->searchFilters(); ?>

<div class="top-bar-ui">

