  ],
  [
    'label' => $translate('Identifier'),
    'value' => 'dcterms:identifier'
  ],
  [
    'label' => $translate('Class'),
    'value' => 'resource_class_label'
  ],
  [
    'label' => $translate('Sort by Date'),
    'value' => 'dcterms:coverage'
  ],
];
?>
<div id="browse" class='browse-tool' <?php if ($itemSetShow): ?>data-redirect="<?= $searchHelper->getSolrItemSetUrl($itemSet->id()) ?>" <?php endif; ?>>
    <div class="page-header">
        <div class="title-block region <?php echo $this->regionClass; ?>" data-target-region-id="<?php echo $this->targetID; ?>">
            <div container>
                <?php if ($itemSetShow): ?>

                    <?php $this->vars()->offsetSet('itemSet', $itemSet); ?>
