                    <?php $this->htmlElement('body')->appendAttribute('class', 'search-page item-set resource browse'); ?>
                    <div id="item-set-page" data-item-set="<?= $itemSet->id(); ?>">
                        <div class="item-label"><?= $translate('Collection') ?></div>
                        <?= $this->pageTitle($itemSet->displayTitle(), 1) ?>
                        <p>
                            <?= $itemSet->value('dcterms:description'); ?>
                        </p>
                        <?php if ($itemSet->value('dcterms:relation')): ?>
                            <div class="label">See also</div>
                            <div class="value">
                                <a target="_blank" href="<?= $itemSet->value('dcterms:relation')->uri() ?>"><?= $itemSet->value('dcterms:relation') ?></a>
                            </div>
                        <?php endif; ?>
                        <?php
                        $url = $searchHelper->getSolrItemSetUrl($itemSet->id());
                        printf("       <div class='collection-link'><a class='button' href='%s'>%s</a></div>",$url,"View Full Collection");
                        ?>

                    </div>
                <?php else: ?>
                    <h1>Search</h1>
                <?php endif; ?>
            </div>
        </div>
        <?php if ($itemSetShow): ?>
        <?php else: ?>
