<?php
/**
 * @file card.phtml
 * @description Displays a card view for a particular item. Use $this->plugin('cardViewer')->getCard($item) to invoke.
 * @var /Laminas/View/View $this
 * @var \Omeka\Entity\Resource $item
 * @var $containerElement Wrapping element can be passed to card via the View Helper
 * @var mixed $item
 */

$translate = $this->plugin('translate');
$escape = $this->plugin('escapeHtml');
$partial = $this->plugin('sitePartial');
$searchHelper = $this->plugin('agileSearchHelper');
$valueDisplay = $this->plugin('valueDisplay');
$propertyTerms = $this->plugin('propertyTerms');
$plugins = $this->getHelperPluginManager();
$filterLocale = (bool) $this->siteSetting('filter_locale_values');
$lang = $this->lang();
$valueLang = $filterLocale ? [$lang, ''] : null;
$assetUrl = $plugins->get('siteAssetUrl');
$keyTerms = $propertyTerms->fromThemeSetting('card_terms') ?: ['dcterms:created','dcterms:date'];

try {
  $textSummary = $this->plugin('textSummary');
} catch (Exception $e)  {
  $textSummary = null;
}
$thumbnailer = $plugins->get('thumbnail');

$cardObjectClass = get_class($item);
$type = 'item';

$bodyTerm = $this->siteSetting('browse_body_property_term');
$viewItemPageLabelTerm  = $this->siteSetting('browse_view_item_page_term');
$viewItemPageLabel = $viewItemPageLabelTerm ? $item->value($viewItemPageLabelTerm, ['default' => $translate('View')]) : 'View item';

$untitled = $translate('[Untitled]');
$thumbnailSize = 'large';
$defaultThumbnail = false;
$contentType = [];

$selectionButton = isset($site) && $plugins->has('selectionButton') && $this->siteSetting('selection_append_items_browse_individual') ? $plugins->get('selectionButton') : null;
$contactUsSelector = isset($site) && $plugins->has('contactUsSelector') && $this->siteSetting('contactus_append_items_browse_individual') ? $plugins->get('contactUsSelector') : null;

// Defaults
$containerElement = $containerElement ?? "div";
$year = '';
$resourceClassLabel = $cardObjectClass ?? 'Item';
$label = $resourceClassLabel;
$creator = '';
$resourceIndicator = '';
$url = '';
$heading = '';
$itemValues = $item->values();

$itemSets = [];

$date = [];
$date['label'] = !empty($itemValue['dcterms:created']['alternate_label']) ?  $itemValue['dcterms:created']['alternate_label'] : 'Date';
$date['value'] = $item->value('dcterms:created');

$backupDate = [];
$backupDate['label'] = !empty($itemValue['dcterms:date']['alternate_label']) ?  $itemValue['dcterms:date']['alternate_label'] : 'Date';
$backupDate['value'] = $item->value('dcterms:date');

$license = [];
$license['label'] = 'Copyright'; //!empty($itemValue['dcterms:license']['alternate_label']) ? $itemValue['dcterms:license']['alternate_label'] : 'License';
$license['value'] = $item->value('dcterms:license');
$license['link'] = $item->value('dcterms:license', ['type' => 'uri', 'all' => true]);

$rights = [];
$rights['label'] = !empty($itemValue['dcterms:rights']['alternate_label']) ? $itemValue['dcterms:rights']['alternate_label'] : 'Rights Statement';
$rights['value'] = $item->value('dcterms:rights');
$rights['uriLabel'] = $item->value('dcterms:rights', ['type' => 'uri']);
$rights['link'] = $item->value('dcterms:rights', ['type' => 'uri', 'all' => true]);


$free_to_use = $rights['uriLabel'] != 'IN COPYRIGHT';

$thumbnailType = $thumbnailType ?? 'large';


$headingTerm = $this->siteSetting('browse_heading_property_term');
$bodyTerm = $this->siteSetting('browse_body_property_term');

switch($cardObjectClass) {
  case 'Omeka\Api\Representation\ItemRepresentation':

    // Item values

    $url = $item->url();
    $altText = $item->value('vra:caption') ? $item->value('vra:caption') : $item->value('dcterms:description');
    $label = 'Item';
    $resourceClassName = "resource-". urlencode(strtolower(str_replace(' ','-',$label)));

    $year = !empty($item->value('dcterms:temporal')) && is_array($item->value('dcterms:temporal')) && count($item->value('dcterms:temporal')) > 0 ? date('Y',$item->value('dcterms:temporal')[0]) : null;
    $creator = $item->value('dcterms:creator');

    if (method_exists($item,'resourceClass') && $item->resourceClass() !== null) {
      $resourceClassLabel = $item->resourceClass()->label();
      $resourceIndicator = "resource-id-" . $item->resourceClass()->id();
    }

    $typeValue = $item->value('dcterms:type');
    $label = $typeValue ? strip_tags($valueDisplay($typeValue, ['link' => false])) : 'Item';

    // Use primary media thumbnail if it exists

    $hasPrimaryMedia = $item->primaryMedia() ? true : false;

    $mimetype = $hasPrimaryMedia ? $item->primaryMedia()->mediaType() : null;
    $hasThumbnail = $mimetype && strpos('image',$mimetype) !== -1; //  $item->thumbnailDisplayUrl($thumbnailSize) !== null;

    $thumbnailObject = $item;


    // If primary media is not an image, look for other attached images.
    // Use the first image (if any) as the thumbnail image.

    if (!$hasThumbnail) {
      foreach ($item->media() as $media) {
        $this_mimetype = $media->mediaType();
        if (!$hasThumbnail && $this_mimetype && strpos('image', $this_mimetype) >= 0) {
          $thumbnailObject = $media;
          $hasThumbnail = true;
        }
      }
    }

    $thumbnail = !empty($altText) ? $this->thumbnail($thumbnailObject, $thumbnailSize,['alt' => $escape(strip_tags($altText)),'class' => "{$resourceIndicator} {$resourceClassName}"]) : $this->thumbnail($item, $thumbnailSize,['class' => "{$resourceIndicator} {$resourceClassName}"]);
    // Omeka's stock thumbnails (no image derivative exists): flagged so they can be styled as placeholders.
    // A theme fork can swap in its own artwork here.

    foreach (['audio.png', 'video.png', 'document.png', 'default.png'] as $stockThumbnail) {
      if (str_contains($thumbnail, $stockThumbnail)) {
        $defaultThumbnail = true;
      }
    }


    $contentType['value'] = ucfirst(!empty($item->value('dcterms:type')) ? $item->value('dcterms:type') : 'Item');
    $heading = !empty($heading) ? $heading : $item->displayTitle();
    $body = $body ?? $item->displayDescription();

    /** @var Omeka\Api\Representation\ItemSetRepresentation $itemSet */
    foreach($item->itemSets() as $itemSet) {
      if ($itemSet->isPublic()) {
        $itemSets[$itemSet->title()] = sprintf("<a class='card--item-set-link' href='%s'>%s</a>", $itemSet->url(), $itemSet->title());
      }
    }

    // Sort Item Sets.

    ksort($itemSets);

    break;

  case 'Omeka\Api\Representation\ItemSetRepresentation':
    $url = $item->url();
    $heading = $headingTerm ? $item->value($headingTerm, ['default' => $translate('[Untitled]'), 'lang' => $valueLang]) : $item->displayTitle(null, $valueLang);
    $header = $escape($heading);
    $thumbnail = $thumbnailer($item, $thumbnailType);
    $label = 'Collection';
    $resourceClassName = "resource-". urlencode(strtolower(str_replace(' ','-',$label)));
    $type = 'Item Set';
    if (empty($body)) {
      $body = $bodyTerm ? $item->value($bodyTerm, ['lang' => $valueLang]) : $item->displayDescription(null, $valueLang);
    }
    break;
  default: // Resources
    $url = $item->url();
    $heading = $headingTerm ? $item->value($headingTerm, ['default' => $translate('[Untitled]'), 'lang' => $valueLang]) : $item->displayTitle(null, $valueLang);
    $header = $escape($heading);
    $thumbnail = $thumbnailer($item, $thumbnailType);
    $label = 'Resource';
    $resourceClassName = "resource-". urlencode(strtolower(str_replace(' ','-',$label)));
    $type = 'Resource';

    if (empty($body)) {
      $body = $bodyTerm ? $item->value($bodyTerm, ['lang' => $valueLang]) : $item->displayDescription(null, $valueLang);
    }
}

$heading_fragment = "“" . substr($heading,0,20) . (strlen($heading > 20) ? "... " : ''). "”";
$cardStyle = isset($cardStyle) ? $cardStyle : 'card';

// @todo: The logic below is wonky. The base theme styling looks for .card.list , so .card is always a class
// This is a source of some complexity in the theme, so it's best to have either .card OR .list and style
// accordingly.

$this->classes = isset($this->classes) ? $this->classes : '';
if (strpos($this->classes, 'card') === false) {
  $this->classes .= " card";
}
?>
<!-- BEGIN TEMPLATE: /agile-item/card -->
<<?= $containerElement; ?> class="<?= $cardStyle ?> <?= $this->classes ?>"<?=  isset($slot) ? " slot={$slot}" : '' ?>>
<div>
  <a <?= !empty($url) ? 'href="'. $url .'"' : ''; ?>>
    <figure class="item-thumbnail <?= $defaultThumbnail || empty($thumbnail) ? "default" : '' ?> <?= $resourceClassName ?> <?= $resourceClassName ?>">
      <?= $thumbnail ?>
    </figure>
  </a>
  <div class="item-info">
    <div class="item-label"><?= $label ?></div>
    <?php if (!empty($heading)): ?>
      <h3 class="item-title title-clamp"> <a <?= !empty($url) ? 'href="'. $url .'"' : ''; ?>><?= $heading ?></a></h3>
    <?php endif; ?>
    <?php if (!empty($creator)): ?>
      <div class="item-sublabel sublabel"><?= $valueDisplay($creator, ['link' => false]) ?></div>
    <?php endif ?>
    <?php if (!empty($body) && $textSummary): ?>
      <div class="item-description"><?= $textSummary->summarize($escape($body),600); ?></div>
    <?php elseif(!empty($body)):?>
      <div class="item-description"><?= $escape($body); ?></div>
    <?php endif; ?>
    <?php if ($type != 'Item Set'): ?>
      <div class='metadata-list'>
        <?php
        $activeTerms = [];
        foreach ($keyTerms as $term) {
          if (isset($itemValues[$term])) {
            $activeTerms[$term] = $itemValues[$term];
          }
        }

        foreach($activeTerms as $term => $propertyData):
          if (!empty($propertyData['values'][0])):
            /** @var \Omeka\Api\Representation\PropertyRepresentation $property */
            $property = $propertyData['property'];
            printf("<div class='property' data-term='%s'>\n",$term);
            printf("   <div class='label'>%s</div>",!empty($propertyData['alternate_label']) ? $propertyData['alternate_label'] : $property->label());
            print ("    <div class='values'>");
            /** @var Omeka\Api\Representation\ValueRepresentation $value */
            foreach($propertyData['values'] as $value)
              if($value->isPublic()):
                printf("       <div class='value'>%s</div>",$valueDisplay($value));
              endif;
            print ("    </div>");
            print ("</div>");
          endif;
        endforeach; ?>
        <!-- DEPRECATED.
        <?php
        if (!empty($date['value'])) :
          ?>
          <div class='metadata-item' data-term='dcterms:created'>
            <div class='label'><?= ($date['label']); ?></div>
            <div class='value'><?=  $date['value'] ? $valueDisplay($date['value'], ['link' => false]) : ''; ?></div>
          </div>
        <?php else: ?>
          <div class='metadata-item' data-term='dcterms:date'>
            <div class='label'><?= ($backupDate['label']); ?></div>
            <div class='value'><?=  $backupDate['value'] !== null ? $valueDisplay($backupDate['value'], ['link' => false]) : '' ?></div>
          </div>
        <?php endif; ?>
        -->
        <?php
        if (count($itemSets) > 0) :
        ?>
        <div class='metadata-item'>
          <div class='label'>Collection<?= count($itemSets) > 1 ? 's' : '' ?></div>
          <div class='value'><?= (join(', ',$itemSets)); ?></div>
        </div>
        <?php
        endif;
        ?>
        <div class='metadata-item license'>
          <div class='label'><?= ($license['label']); ?></div>
          <div class='value license-and-icon'>
            <div><?= $rights['uriLabel'] ? $valueDisplay($rights['uriLabel']) : '' ?></div>
          </div>
        </div>
      </div>
    <?php endif; ?>
    <?php if (!empty($body) && $textSummary): ?>
      <div class="item-description"><?= $textSummary->summarize($escape($body),600); ?></div>
    <?php elseif(!empty($body)):?>
      <div class="item-description"><?= $escape($body); ?></div>
    <?php endif; ?>
    <!-- <a class="more" <?= !empty($url) ? 'href="'. $url .'"' : ''; ?>><?= $viewItemPageLabel ?></a> -->
    <?php if ($selectionButton || $contactUsSelector): ?>
      <footer>
        <?php if ($selectionButton): ?>
        <?= $selectionButton($resource) ?>
        <?php endif; ?>
        <?php if ($contactUsSelector): ?>
          <?= $contactUsSelector($resource) ?>
        <?php endif; ?>
      </footer>
    <?php endif; ?>


  </div>
</div>
</<?php print $containerElement; ?> >
<!-- END TEMPLATE: /agile-item/card -->

