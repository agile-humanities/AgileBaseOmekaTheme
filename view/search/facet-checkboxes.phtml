<?php
/**
 * @var \Laminas\View\Renderer\PhpRenderer $this
 * @var string $name
 * @var array $facetValues With value, count, active, label and url when needed.
 * @var array $options
 * @var array|null $tree For item sets tree or thesaurus. Don't contain data from item sets not in the site.
 */

$plugins = $this->getHelperPluginManager();
$escape = $plugins->get('escapeHtml');
$escapeAttr = $plugins->get('escapeHtmlAttr');

/** @var \AgileThemeTools\View\Helper\ItemSetFacetHandler $itemSetFacetHandler */
$itemSetFacetHandler = $plugins->get('itemSetFacetHandler');

$isFacetModeDirect = in_array($options['mode'] ?? null, ['link', 'js']);
$displayCount = !empty($options['display_count']);

$isTree = is_array($tree);


?>
<!-- BEGIN TEMPLATE search/facet-checkboxes -->
<ul class="facet-items search-facet-items facet-checkboxes">
    <?php
    foreach ($facetValues as $facetValue):
        $escapedValue = $escapeAttr($facetValue['value']);
        $escapedId = $name . '[]' . $escapedValue;
        // Solr item-set facets (indexed by title): "field" is supplied in facets-list.phtml so they can be identified here.
        $isItemSet = array_key_exists('field',$facetValue) && ($facetValue['field'] === 'item_set_dcterms_title_ss' || $facetValue['field'] === 'item_set_title_alt_ss');
        $facetClass = urlencode(strtolower(str_replace(' ','-',$facetValue['value'])));


        /* The item set’s label is empty when an item set id is passed to the checkbox facet.
         * This conditional works in tandem with logic in the facets-list.phtml, which adds an extra facet
         * value key with the Item Set’s display name. Adding a key should keep it backwards compatible if this is fixed
         * (or properly configured, if that's the issue).
         *
         * NOTE: This has been corrected in a recent update. It still applies to Item Set Trees, however, but special
         * handling is below.
         */

        if ($facetValue['field'] == "item_sets_tree" && $facetValue['value'] == (int)$facetValue['value']) {
            $facetValue['label'] = $itemSetFacetHandler->getItemSetLabelById($facetValue['value']);
        }
        $facetValue['label'] = !empty($facetValue['label']) ? $facetValue['label'] : (array_key_exists('item_set_label',$facetValue) ? $facetValue['item_set_label'] : $facetValue['label']);
        $label = $displayCount
            ? sprintf('<span>%s <span class="count">(%d)</span></span>', $escape($facetValue['label']),  $facetValue['count'])
            : $escape($facetValue['label']);
        $treeVal = $isTree ? $tree[$facetValue['value']] ?? null : null;
        $treeValAttrs = $treeVal ? sprintf(' data-value="%s" data-parent="%s" data-level="%s"', $treeVal['id'], $treeVal['parent'], $treeVal['level']) : '';
        $facetClass = urlencode(strtolower(str_replace(' ','-',$facetValue['value'])));
        ?>
    <?php
    // Hides private item sets from Solr item-set facets; everything else is shown.
        if (!$isItemSet || ($itemSetFacetHandler->isPublicItemSet($facetValue['label']) && $isItemSet)):
    ?>
            <li class="facet-item <?= $facetClass ?> <?= $facetValue['active'] ? 'active' : 'inactive' ?> <?= !empty($facetValue['primary_collection']) ? 'primary-collection' : '' // Set in facets-list.phtml ?>" <?= $treeValAttrs ?>>
                <input type="checkbox" name="<?= "facet[$name][]" ?>" id="<?= $escapedId ?>" value="<?= $escapedValue ?>"<?= $isFacetModeDirect ? ' data-url="' . $escapeAttr($facetValue['url']) . '"' : '' ?><?= $facetValue['active'] ? ' checked="checked"' : '' ?>/>
                <label for="<?= $escapedId ?>"><?= $label ?></label>
            </li>
    <?php endif; ?>
    <?php endforeach; ?>
</ul>
<!-- END TEMPLATE search/facet-checkboxes -->
